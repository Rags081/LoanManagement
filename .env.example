# ==============================================================================
# Loan Management System - Environment Configuration
# ==============================================================================

# Database Driver: 'mysql' (default) or 'mongodb'
DB_DRIVER=mysql

# MySQL Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loan_management
DB_USER=root
DB_PASSWORD=your_secure_database_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# MongoDB Database Configuration (MongoDB 6.0+ / Atlas)
MONGODB_URI=MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGODB_DATABASE=loan_management
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRY=24h
JWT_RESET_EXPIRY=1h

# Rate Limiting (Netlify Functions & Auth endpoints)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Netlify Functions Dev Port
NETLIFY_FUNCTIONS_PORT=9999

# Frontend Vite Environment Variables
VITE_API_URL=/api
VITE_APP_NAME="Loan Management System"

# Sentry / Monitoring (Optional)
SENTRY_DSN=
VITE_SENTRY_DSN=
